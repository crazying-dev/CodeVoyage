# ---------- 服务 ----------
# Flask 运行端口，app.run 仅用于开发调试
PORT=5000
# 接收 GitHub workflow 上报用的签名密钥（生成 workflow 时会直接写入文件）
WEBHOOK_SECRET=change_me
# 对外可访问的服务端地址，用于写死进 workflow；留空则取请求的 host
# PUBLIC_BASE_URL=https://codevoyage.example.com

# ---------- 数据库 ----------
# 默认 instance/codevoyage.db，可指定绝对/相对路径
# DATABASE_URL=/data/codevoyage.db

# ---------- SMTP 邮件（不配置则邮件停用，仅写日志） ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=noreply@example.com
MAIL_PASS=your_password
# MAIL_FROM=CodeVoyage <noreply@example.com>
MAIL_USE_SSL=1
